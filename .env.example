# .env.example — Copy to .env and fill in your actual values.
# Never commit .env to version control.

# ---- LLM Configuration ----
LLM_PROVIDER=gemini                         # Options: "gemini" | "openai"
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash               # gemini-1.5-flash is fast + cheap; swap to gemini-1.5-pro for higher quality
OPENAI_API_KEY=your_openai_api_key_here     # Only required if LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini

# ---- Embedding Model ----
EMBEDDING_MODEL=all-MiniLM-L6-v2           # Local sentence-transformer model; no API key required

# ---- Vector DB ----
CHROMA_PERSIST_DIR=docs/processed/chroma

# ---- Model Paths ----
LIGHTGBM_MODEL_PATH=models/lightgbm.pkl
